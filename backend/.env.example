# =============================================================================
# Nexora Backend Environment Variables Template
# Copy this file to .env and replace placeholders with your actual secrets.
# NEVER commit .env to version control!
# =============================================================================

# Django Core Settings
DEBUG=False
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,api.nexora.io
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://nexora.io
CORS_ALLOW_ALL_ORIGINS=False

# AI Service Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your-openai-api-key-if-used

# OAuth Authentication (Google & GitHub)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Email Delivery Configuration (Official Nexora Sender: nexora.officalss@gmail.com)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=nexora.officalss@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL=Nexora Team <nexora.officalss@gmail.com>
EMAIL_TIMEOUT=10

# Frontend Base URL (Used in email CTA links and redirects)
FRONTEND_URL=http://localhost:5173

# Database Connection (Supabase PostgreSQL or local SQLite fallback)
# Leave unset to use local SQLite, or set to your Supabase PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres?sslmode=require
