# Nexora Environment Configuration Example
# Copy to .env for local development

DEBUG=True
SECRET_KEY=nexora-insecure-dev-secret-key-change-in-production-2026-xyz
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults to SQLite if DATABASE_URL is not set)
# DATABASE_URL=postgresql://user:password@localhost:5432/nexora

# CORS configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI / LLM Configuration (pure rule-based + grounded RAG fallback active if omitted)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# GEMINI_API_KEY=
# OPENAI_API_KEY=
