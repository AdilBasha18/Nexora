# =============================================================================
# Nexora Frontend Environment Variables Template
# Copy this file to .env and configure your public client IDs.
# =============================================================================

# OAuth Public Client IDs
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GITHUB_CLIENT_ID=your-github-client-id
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/login

# API Base URL (leave blank to use default relative /api proxy)
VITE_API_BASE_URL=http://localhost:8000
